{
  "permissions": {
    "allow": [
      "Bash(gh pr review --approve*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/check-pr-approve.sh\"",
            "if": "Bash(gh pr review --approve*)"
          }
        ]
      }
    ]
  }
}
